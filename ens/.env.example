# ── ens service ───────────────────────────────────────────────────
# Copy to .env. NEVER commit .env (it holds keys).

# dev  = synthetic HCS ids + INVITE_TOKENS allowlist (no Hedera keys needed)
# live = real HCS topic submit + invite tokens read back from the topic
ENS_MODE=dev
PORT=8404

# ── ENS chain (Sepolia for the demo; mainnet is design-approved, not authorized) ──
# Sepolia JSON-RPC endpoint (bring your own provider key; never commit it)
ENS_RPC_URL=
# parent name owned by the issuing wallet, e.g. `oso.eth`. NOT chosen yet —
# the owner will supply it. Leave empty; the service refuses to issue without it.
ENS_PARENT_NAME=
# private key of the parent owner. Testnet/demo key only; never a mainnet
# treasury. Lives in .env only (repo rule: no secrets committed).
ENS_PARENT_OWNER_KEY=
# ENS Registry. Deployed at the canonical address on mainnet and Sepolia.
ENS_REGISTRY_ADDRESS=0x00000000000C2E074eC69A0dFb2997BA6C7d2e1e
# Public resolver that will hold the artist's records. Take it from the
# official ENS deployments page for the target chain before any write —
# this template deliberately ships no guessed address.
ENS_RESOLVER_ADDRESS=

# ── Hedera: claim audit log (same topic family as payments/) ──────
HEDERA_NETWORK=hedera:testnet
HCS_CLAIM_TOPIC_ID=
# account + key that submits claim events to the topic (server-side only)
HCS_ACCOUNT_ID=
HCS_PRIVATE_KEY=
# Mirror node REST base, used to read invite announcements back from the topic
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# ── invites (dev-mode fallback) ───────────────────────────────────
# comma-separated one-time tokens. In live mode tokens are announced to the
# HCS topic via `npm run announce-invite` and validated through the mirror node.
INVITE_TOKENS=
